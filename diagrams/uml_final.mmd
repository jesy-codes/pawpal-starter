classDiagram
    %% PawPal+ UML, matching the implementation in pawpal_system.py.
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +set_available_time(minutes: int) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: str) None
        +mark_task_complete(task_id: str, on: date) Task
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +Optional~str~ preferred_time
        +Optional~str~ fixed_time
        +str frequency
        +Optional~date~ due_date
        +Optional~date~ last_completed
        +str pet_name
        +str task_id
        -_validate() None
        +priority_rank() int
        +edit(title: str, duration_minutes: int, priority: str) None
        +mark_complete(on: date) None
        +is_complete() bool
        +next_occurrence() Task
        +is_due(on: date) bool
    }

    class ScheduledTask {
        +Task task
        +datetime start
        +str reason
        +datetime end
        +str time
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +Optional~date~ plan_date
        +list~ScheduledTask~ plan
        +list~tuple~ skipped
        +generate_plan(on: date) list~ScheduledTask~
        +find_conflicts() list~tuple~
        +detect_conflicts() list~str~
        +mark_task_complete(task_id: str, on: date) Task
        +sort_by_time(entries: list~ScheduledTask~)$ list~ScheduledTask~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +explain_plan() str
        -_next_free_slot(clock, minutes, busy)$ datetime
        -_at(hhmm: str) datetime
    }

    note for Task "priority: high | medium | low, ranked 3 / 2 / 1 via PRIORITY_RANK<br>frequency: daily | weekly<br>preferred_time: morning | afternoon | evening | None<br>fixed_time: exact HH:MM, overrides preferred_time"
    note for ScheduledTask "end and time are read-only properties computed from start"
    note for Scheduler "skipped holds (Task, reason) pairs<br>find_conflicts() returns overlapping (ScheduledTask, ScheduledTask) pairs<br>underlined methods are static<br>fixed-time tasks are placed first; others move past them<br>afternoon tasks start no earlier than 12:00, evening no earlier than 18:00"

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Task ..> Pet : belongs to (pet_name)
    Scheduler --> Owner : reads available time and get_all_tasks()
    Scheduler "1" *-- "0..*" ScheduledTask : plan
    ScheduledTask --> Task : places
    Scheduler --> Task : skips
    Scheduler ..> Pet : mark_task_complete() delegates
    Task ..> Task : next_occurrence() creates
